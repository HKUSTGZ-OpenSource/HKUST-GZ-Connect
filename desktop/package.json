{
  "name": "hkustgzconnect",
  "version": "2.0.2",
  "description": "HKUST(GZ) EasyConnect-compatible client with an independent Rust engine",
  "main": "main.js",
  "author": "heeh02",
  "license": "GPL-3.0-only",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.js",
    "check:governance": "node ../.github/scripts/check-repository-governance.js",
    "audit:ci": "node ../.github/scripts/check-dependency-vulnerabilities.js",
    "check:install-scripts": "node scripts/check-install-scripts.js",
    "check:syntax": "node scripts/check-javascript-syntax.js",
    "check:secrets": "node scripts/check-sensitive-patterns.js",
    "test": "node --test",
    "test:windows": "node --test test/unit/platform/storage/windows-private-file.test.js test/unit/persistence/migration/legacy-hkust/legacy-flat-source-receipts.test.js test/unit/app/startup/multi-school-startup-runtime.test.js test/windows-platform-smoke.test.js",
    "test:browser-performance": "electron e2e/browser-performance.electron.js",
    "test:auth-control-e2e": "node e2e/auth-control-fixture.js",
    "test:campus-mfa-safety": "electron e2e/campus-mfa-safety.electron.js",
    "test:campus-popup-mfa-safety": "node e2e/campus-popup-mfa-safety.js",
    "test:control-renderer-recovery": "electron e2e/control-renderer-recovery.electron.js",
    "test:idle-performance": "electron scripts/idle-performance-baseline.js",
    "test:routing-restart": "node e2e/routing-restart.electron.js",
    "test:renderer-layout": "electron e2e/resource-manager-layout.electron.js",
    "test:control-shell-layout": "electron e2e/control-shell-layout.electron.js",
    "test:workspace-layout": "electron e2e/campus-workspace-layout.electron.js",
    "test:main-integration": "electron e2e/main-integration.electron.js",
    "test:main-custom-profile": "electron e2e/main-custom-profile.electron.js",
    "test:main-school-onboarding": "node e2e/main-school-onboarding.electron.js",
    "test:main-profile-switch": "node e2e/main-profile-switch.electron.js",
    "test:main-engine-lifecycle": "electron e2e/main-engine-lifecycle.electron.js",
    "test:main-network-startup": "electron e2e/main-network-startup.electron.js",
    "test:persistence-migration": "electron e2e/persistence-migration.electron.js",
    "test:upgrade-compatibility": "node --test test/unit/persistence/upgrades/profile-workspace-upgrade.test.js && electron e2e/persistence-migration.electron.js",
    "test:profile-asar": "electron e2e/school-profile-asar.electron.js",
    "test:strict-proxy-auth": "electron e2e/strict-proxy-auth.electron.js",
    "make:icons:mac": "bash scripts/make-icons.sh",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "build:windows-private-file": "node scripts/build-windows-private-file.js",
    "predist:win": "npm run build:windows-private-file",
    "test:login-responsive": "electron e2e/login-responsive.electron.js",
    "pretest:windows": "npm run build:windows-private-file"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6"
  },
  "build": {
    "appId": "cn.edu.hkust-gz.connect",
    "productName": "hkustgzconnect",
    "artifactName": "hkustgzconnect-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "campus-preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!lib/**/*.c"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "ec-engine-*",
          "ec-engine.exe",
          "ec-proxy-command-*",
          "ec-proxy-command.exe",
          "ec-gateway-probe-*",
          "ec-gateway-probe.exe",
          "*.json",
          "ec-private-file-windows-*.exe"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "hkustgzconnect-${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network"
    }
  }
}
