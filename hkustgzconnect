#!/usr/bin/env bash
# macOS wrapper for the independent Rust EasyConnect engine.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
ENGINE="$HERE/independent/target/release/ec-engine"
PROXY_HELPER="$HERE/independent/target/release/ec-proxy-command"
ENGINE_CONFIG="$HERE/independent/config/hkustgz.json"
REVIEWED_ENGINE_CONFIG_SHA256="ce049050e839305efbc9549d405e62c34ce98ceb425e3b027f21f2a55e8683d3"
CONF="$HERE/config.toml"

RUNDIR="$HOME/.hkustgzconnect"
LOG="$RUNDIR/hkustgzconnect.log"
PIDFILE="$RUNDIR/hkustgzconnect.pid"
PROXY_CREDENTIAL="$RUNDIR/local-proxy-credential"
KEYCHAIN_SERVICE="hkustgzconnect"
SOCKS_HOST="127.0.0.1"
SOCKS_PORT="$(awk -F'[:\"]' '/^socks_bind/{print $(NF-1); exit}' "$CONF" 2>/dev/null)"
SOCKS_PORT="${SOCKS_PORT:-1080}"
[[ "$SOCKS_PORT" =~ ^[0-9]+$ ]] && [ "$SOCKS_PORT" -ge 1025 ] && [ "$SOCKS_PORT" -le 65535 ] \
  || { echo "✗ SOCKS port must be within 1025..65535" >&2; exit 1; }
LABEL="com.hkustgz.connect"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
HPC_PROBE_IP="10.120.48.30"
PROXY_CREDENTIAL_LIBRARY="$HERE/tools/mac-cli/proxy-credential.sh"

[ -r "$PROXY_CREDENTIAL_LIBRARY" ] || {
  echo "✗ local proxy credential support is missing" >&2
  exit 1
}
# shellcheck source=tools/mac-cli/proxy-credential.sh
source "$PROXY_CREDENTIAL_LIBRARY"

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
touch "$LOG"
chmod 600 "$LOG"

ACC="$(awk -F'"' '/^username/{print $2; exit}' "$CONF" 2>/dev/null)"
die(){ echo "✗ $*" >&2; exit 1; }
[ -f "$CONF" ] || die "missing local identity config: $CONF"
[ -n "$ACC" ] || die "no username in $CONF"

regex_escape(){ printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/[][^$.*+?(){}|]/\\&/g'; }
get_pw(){ security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$ACC" -w 2>/dev/null; }
running_pid(){ [ -f "$PIDFILE" ] && awk 'NR==1{print; exit}' "$PIDFILE" 2>/dev/null; }
is_up(){ local p; p="$(running_pid)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
socks_listening(){ lsof -nP -iTCP@"$SOCKS_HOST":"$SOCKS_PORT" -sTCP:LISTEN >/dev/null 2>&1; }
proxies_listening(){ socks_listening; }
svc_loaded(){ launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }

ensure_engine(){
  [ -x "$ENGINE" ] && [ -x "$PROXY_HELPER" ] && return 0
  if command -v cargo >/dev/null 2>&1; then
    cargo_runner=(cargo)
  elif command -v rustup >/dev/null 2>&1; then
    toolchain_bin="$(dirname "$(rustup which rustc --toolchain 1.97.1)")"
    cargo_runner=(env "PATH=$toolchain_bin:$PATH" rustup run 1.97.1 cargo)
  else
    die "engine missing and cargo/rustup is unavailable"
  fi
  (cd "$HERE/independent" && "${cargo_runner[@]}" build --locked --release \
    --bin ec-engine --bin ec-proxy-command) \
    || die "independent engine build failed"
}

wait_socks(){
  for _ in $(seq 1 20); do
    proxies_listening && return 0
    grep -qiE "authentication failed|unsupported|ec-engine:" "$LOG" 2>/dev/null && return 1
    sleep 1
  done
  proxies_listening
}

report_up(){
  if proxies_listening; then
    echo "✓ up — authenticated SOCKS5 $SOCKS_HOST:$SOCKS_PORT"
  else
    echo "✗ failed to come up — last log lines:"
    tail -8 "$LOG" 2>/dev/null | sed 's/^/  /'
    return 1
  fi
}

run_engine(){
  local binding_frame pw
  printf -v binding_frame '{"type":"engine_config_binding","apiVersion":1,"configSha256":"%s","gatewayOrigin":"https://remote.hkust-gz.edu.cn","profileId":"hkustgz","profileRevision":1,"protocolFamily":"easyconnect-password-modern-l3-v1"}' \
    "$REVIEWED_ENGINE_CONFIG_SHA256"
  pw="$(get_pw)" || true
  [ -n "${pw:-}" ] || die "no password in Keychain — run: $(basename "$0") set-password"
  cli_proxy_load_or_create "$PROXY_CREDENTIAL" "$SOCKS_HOST:$SOCKS_PORT" \
    || die "local proxy credential file is unsafe or unavailable"
  {
    printf '%s\n' "$binding_frame"
    printf '%s\n' "$ACC"
    printf '%s\n' "$pw"
    printf '%s\n' "$CLI_PROXY_USERNAME"
    printf '%s\n' "$CLI_PROXY_PASSWORD"
  } | "$ENGINE" \
    --config "$ENGINE_CONFIG" \
    --profile-binding-v1-stdin \
    --credentials-stdin \
    --socks-bind "$SOCKS_HOST:$SOCKS_PORT" \
    --generation 1 \
    --socks-auth-stdin
  pw=''
  cli_proxy_clear
}

case "${1:-}" in
  set-password)
    # `security ... -w "$pw"` would expose the password in the process arguments,
    # which any local user can read with ps. Passing -w last makes security
    # prompt for the secret itself, so it never becomes an argv entry.
    echo "Password for $ACC @ HKUST-GZ VPN (security will prompt twice):" >&2
    security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$ACC" -w \
      && echo "✓ stored in Keychain" \
      || die "password was not stored"
    ;;

  run)
    ensure_engine
    echo $$ > "$PIDFILE"
    run_engine
    ;;

  up)
    proxies_listening && { echo "✓ already running — SOCKS5 $SOCKS_HOST:$SOCKS_PORT"; exit 0; }
    ensure_engine
    get_pw >/dev/null 2>&1 || die "no password in Keychain — run set-password"
    : > "$LOG"
    if [ -f "$PLIST" ]; then
      launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl kickstart "gui/$(id -u)/$LABEL" 2>/dev/null
    else
      nohup "$0" run >>"$LOG" 2>&1 &
      echo $! > "$PIDFILE"
      disown 2>/dev/null || true
    fi
    wait_socks
    report_up || { "$0" down >/dev/null 2>&1; exit 1; }
    ;;

  down)
    svc_loaded && launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    local_pid="$(running_pid)"
    [ -n "$local_pid" ] && kill -INT "$local_pid" 2>/dev/null
    # pkill -f takes an extended regular expression. A checkout path containing
    # regex metacharacters (for example parentheses) would otherwise silently
    # match nothing and leave the engine running.
    pkill -f "^$(regex_escape "$ENGINE") " 2>/dev/null
    [ -f "$PIDFILE" ] && mv "$PIDFILE" "$RUNDIR/hkustgzconnect.pid.stopped"
    echo "✓ down"
    ;;

  restart)
    "$0" down >/dev/null 2>&1
    sleep 1
    exec "$0" up
    ;;

  status)
    if is_up; then echo "● running (pid $(running_pid))"; else echo "○ not running"; fi
    socks_listening && echo "  SOCKS5 $SOCKS_HOST:$SOCKS_PORT: listening" || echo "  SOCKS5: not listening"
    get_pw >/dev/null 2>&1 && echo "  Keychain password: present" || echo "  Keychain password: missing"
    [ -x "$ENGINE" ] && echo "  independent engine: built" || echo "  independent engine: not built"
    if cli_proxy_read_file "$PROXY_CREDENTIAL"; then
      echo "  local proxy authentication: required (credential ready)"
      cli_proxy_clear
    else
      echo "  local proxy authentication: required (credential created on next start)"
    fi
    [ -f "$PLIST" ] && echo "  autostart: installed" || echo "  autostart: not installed"
    ;;

  test)
    socks_listening || die "SOCKS not listening"
    [ -x "$PROXY_HELPER" ] || ensure_engine
    cli_proxy_load_or_create "$PROXY_CREDENTIAL" "$SOCKS_HOST:$SOCKS_PORT" \
      || die "local proxy credential file is unsafe or unavailable"
    echo -n "HPC $HPC_PROBE_IP:22 via independent SOCKS → "
    banner="$("$PROXY_HELPER" --credential-file "$PROXY_CREDENTIAL" -- \
      "$HPC_PROBE_IP" 22 </dev/null 2>/dev/null | head -1)"
    cli_proxy_clear
    [ -n "$banner" ] && echo "$banner" || echo "(no banner / unreachable)"
    ;;

  proxy-config)
    cli_proxy_load_or_create "$PROXY_CREDENTIAL" "$SOCKS_HOST:$SOCKS_PORT" \
      || die "local proxy credential file is unsafe or unavailable"
    echo "# Sensitive local-only proxy credential; do not publish this output."
    echo "proxies:"
    echo "  - name: HKUST(GZ) Connect CLI"
    echo "    type: socks5"
    echo "    server: $SOCKS_HOST"
    echo "    port: $SOCKS_PORT"
    echo "    username: $CLI_PROXY_USERNAME"
    echo "    password: $CLI_PROXY_PASSWORD"
    echo "    udp: false"
    cli_proxy_clear
    ;;

  install)
    ensure_engine
    get_pw >/dev/null 2>&1 || die "set the password first"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$HERE/hkustgzconnect</string><string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PLIST
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
      || launchctl load "$PLIST" 2>/dev/null
    echo "✓ independent engine autostart installed"
    : > "$LOG"
    wait_socks
    report_up
    ;;

  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null \
      || launchctl unload "$PLIST" 2>/dev/null
    [ -f "$PLIST" ] && mv "$PLIST" "$RUNDIR/com.hkustgz.connect.plist.uninstalled"
    echo "✓ autostart removed"
    ;;

  logs)
    tail -n 40 -f "$LOG"
    ;;

  *)
    cat <<USAGE
hkustgzconnect — independent Rust EasyConnect client

  set-password   store the VPN password in macOS Keychain
  up             build if needed and start the single SOCKS5 listener
  down           stop the engine
  restart        restart the engine
  status         show engine and proxy state
  test           read the approved HPC SSH banner through authenticated SOCKS
  proxy-config   print a sensitive Clash/Mihomo node for the local proxy
  logs           follow engine logs
  install        install launchd autostart
  uninstall      remove launchd autostart
USAGE
    ;;
esac
